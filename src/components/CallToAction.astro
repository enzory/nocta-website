---
interface Props {
  variant?: 'dark' | 'light';
  subtitle?: string;
  heading?: string;
  /* Destination et libellé du bouton. Par défaut le devis, mais /contact
     porte un bloc « Appelez-nous directement. » : y renvoyer vers /contact
     renvoyait vers la page elle-même. */
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  variant = 'dark',
  subtitle,
  heading = 'Parlons de votre événement.',
  ctaHref = '/contact',
  ctaLabel = 'Demander un devis',
} = Astro.props;

const isDark = variant === 'dark';
---

<!-- CTA -->
<section class:list={[
  'py-24 lg:py-36',
  isDark ? 'bg-nocta-black' : 'bg-nocta-cream border-t border-nocta-black/10',
]}>
  <div class="max-w-7xl mx-auto px-6 lg:px-12 text-center reveal">
    {subtitle && (
      <p class:list={[
        't-eyebrow mb-6',
        /* Seul endroit du site où --color-nocta-grey tombait sur du noir.
           Assombri à #6A6A66 pour le cream, il y serait passé de 6,06:1 à
           3,87:1. cream/60 rend rgb(143,141,136) — à 5/255 de l'ancien gris,
           donc rendu inchangé — pour 6,33:1. */
        isDark ? 'text-nocta-cream/60' : 'text-nocta-grey',
      ]}>{subtitle}</p>
    )}
    <h2 class:list={[
      't-h2 mb-10',
      isDark ? 'text-nocta-cream' : 'text-nocta-black max-w-2xl mx-auto',
    ]}>
      {heading}
    </h2>
    <a
      href={ctaHref}
      class:list={[
        'inline-flex items-center font-sans text-sm font-light tracking-widest uppercase px-8 py-3 transition-all duration-300',
        isDark
          ? 'bg-nocta-cream text-nocta-black hover:bg-white'
          : 'bg-nocta-black text-nocta-cream hover:bg-nocta-black/80',
      ]}
    >
      {ctaLabel}
    </a>
  </div>
</section>
