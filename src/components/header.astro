---
const pathname = Astro.url.pathname;

// `light` = page dont le haut est clair (cream) sans hero sombre derrière le
// header fixe (GEO, hub, mentions, journal, contact). Le header démarre alors
// en texte noir au lieu de blanc — sinon logo + nav sont invisibles sur cream.
const { light = false } = Astro.props;

const navLinks = [
  { label: 'Notre Maison', href: '/maison' },
  { label: 'Prestations',  href: '/prestations' },
  { label: 'Journal',      href: '/journal' },
  { label: 'Contact',      href: '/contact' },
];
---

<header id="header" data-top-theme={light ? 'dark' : 'light'} class:list={["fixed top-0 left-0 right-0 z-50 transition-all duration-500", light ? 'text-nocta-black' : 'text-white']}>
  <div class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">

    <!-- data-logo-tempo : 1 = séquence complète (~2,7 s) ; 0.58 en header (~1,6 s). -->
    <a href="/" class="flex items-center" aria-label="NOCTA - Accueil" data-logo-stopmotion data-logo-tempo="0.58">
      <span class="logo-svg" aria-hidden="true"></span>
    </a>

    <nav class="hidden lg:flex items-center gap-10">
      {navLinks.map(link => {
        const isActive = pathname === link.href || pathname.startsWith(link.href + '/');
        return (
          <a href={link.href} class={`t-label text-inherit relative after:absolute after:bottom-0 after:left-0 after:h-px after:bg-current after:transition-all after:duration-300 hover:after:w-full transition-opacity duration-200 hover:opacity-60 ${isActive ? 'after:w-full' : 'after:w-0'}`}>
            {link.label}
          </a>
        );
      })}
    </nav>

    <a href="/contact" class="t-label hidden lg:inline-flex items-center gap-2 border border-current text-inherit px-6 py-3 transition-all duration-300 hover:bg-nocta-black hover:text-nocta-cream hover:border-nocta-black">
      Demander un devis
    </a>

    <button id="burger" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label="Menu" aria-expanded="false">
      <span class="block w-6 h-px bg-current transition-all duration-300"></span>
      <span class="block w-6 h-px bg-current transition-all duration-300"></span>
      <span class="block w-4 h-px bg-current transition-all duration-300"></span>
    </button>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden bg-nocta-cream border-t border-nocta-black/10">
    <nav class="max-w-7xl mx-auto px-6 py-8 flex flex-col gap-6">
      {navLinks.map(link => (
        <a href={link.href} class="t-label text-nocta-black">
          {link.label}
        </a>
      ))}
      <a href="/contact" class="t-label border border-nocta-black text-nocta-black px-6 py-3 text-center hover:bg-nocta-black hover:text-nocta-cream transition-all duration-300">
        Demander un devis
      </a>
    </nav>
  </div>
</header>

<style>
  /* Logo externalisé (public/images/nocta-logo.svg) rendu en CSS mask :
     background-color: currentColor préserve le swap blanc → noir au scroll. */
  .logo-svg {
    display: block;
    height: 52px;
    aspect-ratio: 170 / 75;
    background-color: currentColor;
    -webkit-mask: url('/images/nocta-logo.svg') no-repeat center / contain;
    mask: url('/images/nocta-logo.svg') no-repeat center / contain;
  }

  /* ── Logo « stop motion » — joué une fois par session ──────────────────
     Par défaut, rien ne change : le logo reste le masque CSS ci-dessus.
     Le script de <head> (layout.astro) pose html[data-logo-anim="play"]
     uniquement à la première page de la session, et jamais sous
     prefers-reduced-motion. Dans ce seul cas, le masque est caché le temps
     que le script ci-dessous le remplace par le même SVG, lettres séparées.
     Filet de sécurité en CSS pur : si le script échoue, le masque réapparaît
     de lui-même au bout de 2,5 s (logoSafety). */
  :global(html[data-logo-anim="play"]) .logo-svg {
    opacity: 0;
    animation: logoSafety 0s linear 2.5s forwards;
  }
  @keyframes logoSafety { to { opacity: 1; } }

  /* SVG inséré par le script (hors du scope Astro, d'où :global). Même boîte
     que .logo-svg : 52 px de haut, ratio du viewBox, centré — aucun décalage. */
  :global(.logo-sm) {
    display: block;
    height: 52px;
    width: auto;
    aspect-ratio: 170 / 75;
  }

  /* Une lettre = 4 poses tenues chacune une image (~12 images/s), sans
     interpolation : steps(1, end) sur chaque palier. Le décalage vertical est
     en unités du viewBox (18 = 18 px quand le logo fait 75 px de haut) : il
     suit la taille du logo. --amp réduit l'amplitude de « Catering », trop
     fin pour sauter de toute la hauteur d'une capitale. */
  @keyframes logoPose {
    0%      { opacity: 0;    transform: translateY(calc(18px * var(--amp))); animation-timing-function: steps(1, end); }
    33.333% { opacity: 0.45; transform: translateY(calc(8px * var(--amp)));  animation-timing-function: steps(1, end); }
    66.667% { opacity: 0.85; transform: translateY(calc(-3px * var(--amp))); animation-timing-function: steps(1, end); }
    100%    { opacity: 1;    transform: none; }
  }
  :global(.logo-sm.is-playing .l) {
    --amp: 1;
    animation: logoPose 0.25s both;
    /* N, O, C, T, A : 0,25 s d'écart, multiplié par le tempo (0.58 en header). */
    animation-delay: calc(var(--i) * 0.25s * var(--tempo, 1));
  }
  :global(.logo-sm.is-playing .l.sig) {
    --amp: 0.45;
    /* « Catering » : départ 1,5 s après le N, 0,13 s d'écart, même tempo. */
    animation-delay: calc((1.5s + var(--i) * 0.13s) * var(--tempo, 1));
  }

  /* Soulignement des liens de navigation : tracé en quatre coups (~12
     images/s), comme la pose du logo, au lieu de s'étirer en continu. */
  nav a::after {
    transition-duration: 0.33s;
    transition-timing-function: steps(4, jump-end);
  }

  @media (prefers-reduced-motion: reduce) {
    nav a::after { transition: none; }
    :global(.logo-sm .l) { animation: none !important; }
    :global(html[data-logo-anim="play"]) .logo-svg { opacity: 1; animation: none; }
  }
</style>

<script>
  const header = document.getElementById('header');
  const burger = document.getElementById('burger');
  const mobileMenu = document.getElementById('mobile-menu');

  // Couleur du texte quand on est en haut de page : noir si la page est claire
  // (data-top-theme="dark"), blanc si un hero sombre est derrière le header.
  const topDark = header?.dataset.topTheme === 'dark';

  window.addEventListener('scroll', () => {
    if (window.scrollY > 80) {
      header?.classList.add('bg-nocta-cream/95', 'backdrop-blur-sm', 'shadow-sm', 'text-nocta-black');
      header?.classList.remove('text-white');
    } else {
      header?.classList.remove('bg-nocta-cream/95', 'backdrop-blur-sm', 'shadow-sm');
      header?.classList.add(topDark ? 'text-nocta-black' : 'text-white');
      header?.classList.remove(topDark ? 'text-white' : 'text-nocta-black');
    }
  });

  burger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden', !isOpen);
    burger.setAttribute('aria-expanded', String(isOpen));
  });

  // ── Logo « stop motion » ────────────────────────────────────────────────
  // Ne tourne que si le script de <head> a posé data-logo-anim="play"
  // (première page de la session, pas de prefers-reduced-motion).
  //
  // Le SVG est relu tel quel depuis /images/nocta-logo.svg (le fichier du
  // masque, déjà en cache) : aucun tracé n'est recopié ni modifié. Seule la
  // structure change : dans le fichier, un clipPath enveloppe tout un bloc de
  // lettres ; ici chaque lettre reçoit sa propre référence au MÊME clipPath,
  // à l'intérieur du groupe qui bouge. La découpe suit donc la lettre pendant
  // la pose, et au repos le rendu est identique au fichier d'origine.
  const html = document.documentElement;
  const logoLink = document.querySelector<HTMLElement>('[data-logo-stopmotion]');

  function abandonLogo() {
    // Le masque réapparaît : le logo statique reste la référence.
    html.removeAttribute('data-logo-anim');
  }

  async function playLogo(link: HTMLElement) {
    const res = await fetch('/images/nocta-logo.svg');
    if (!res.ok) throw new Error(`logo ${res.status}`);
    const doc = new DOMParser().parseFromString(await res.text(), 'image/svg+xml');
    const svg = doc.documentElement;
    if (svg.nodeName !== 'svg') throw new Error('logo illisible');

    const SVG_NS = 'http://www.w3.org/2000/svg';
    // Identifiants préfixés : jamais de doublon avec un autre SVG de la page.
    svg.querySelectorAll('clipPath[id]').forEach((cp) => { cp.id = `hl-${cp.id}`; });

    let cap = 0;
    let sig = 0;
    svg.querySelectorAll(':scope > g > g[clip-path]').forEach((block) => {
      const clip = (block.getAttribute('clip-path') || '').replace('url(#', 'url(#hl-');
      block.removeAttribute('clip-path');
      // Le premier bloc porte N-O-C-T-A ; les deux suivants « Caterin » + « g ».
      const isCaps = clip.includes('nocta-clip-a');
      Array.from(block.children).forEach((letter) => {
        const pose = doc.createElementNS(SVG_NS, 'g');
        const clipWrap = doc.createElementNS(SVG_NS, 'g');
        pose.setAttribute('class', isCaps ? 'l' : 'l sig');
        pose.setAttribute('style', `--i:${isCaps ? cap++ : sig++}`);
        clipWrap.setAttribute('clip-path', clip);
        block.insertBefore(pose, letter);
        clipWrap.appendChild(letter);
        pose.appendChild(clipWrap);
      });
    });
    if (cap !== 5 || sig !== 8) throw new Error(`logo : ${cap}+${sig} lettres`);

    svg.setAttribute('class', 'logo-sm is-playing');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('focusable', 'false');
    svg.setAttribute('style', `--tempo:${link.dataset.logoTempo || '1'}`);

    const node = document.importNode(svg, true);
    link.querySelector('.logo-svg')?.replaceWith(node);
    html.removeAttribute('data-logo-anim');

    // Fin de la dernière lettre : on retire les animations, le logo redevient
    // un SVG fixe identique au masque.
    const letters = node.querySelectorAll('.l');
    letters[letters.length - 1]?.addEventListener('animationend', () => {
      node.classList.remove('is-playing');
    }, { once: true });
  }

  if (logoLink && html.dataset.logoAnim === 'play') {
    playLogo(logoLink).catch(abandonLogo);
  }
</script>