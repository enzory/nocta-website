---
import levisSrc          from '../assets/logos/levis.svg?url';
import biologiqueSrc     from '../assets/logos/biologique-recherche.svg?url';
import galionSrc         from '../assets/logos/the-galion.svg?url';
import columbusSrc       from '../assets/logos/colombus-consulting.svg?url';
import jusMundiSrc       from '../assets/logos/jus-mundi.svg?url';
import aaConseilSrc      from '../assets/logos/aa-conseil.svg?url';
import messikaSrc        from '../assets/logos/messika.png?url';
import originatorSrc     from '../assets/logos/originator.png?url';

// Hauteurs calibrees sur la SURFACE D'ENCRE de chaque logo (poids visuel percu),
// pas sur leur hauteur brute : un aplat massif pese plus qu'un trace en traits fins.
// Correction amortie a 60 % d'une egalisation totale — au-dela, les logos les plus
// legers (AA Conseil) devenaient geometriquement enormes. Ecart d'encre ramene de
// [-66 %, +107 %] a [-46 %, +39 %]. Rendu = min(h x ratio, 120) de large (max-width CSS).
// `iw`/`ih` = dimensions INTRINSEQUES de chaque fichier. Elles etaient auparavant
// figees a 160x60 pour tous (ratio 2.67) : comme la largeur est en `auto`, le
// navigateur s'appuyait sur ce faux ratio et bridait les logos plus larges
// (Originator, ratio 5.54, ne rendait qu'a 48 % de sa taille voulue).
//
// TAILLES : les logos compacts (carres) sont cales sur 68 px de haut — en dessous,
// leurs mentions fines ("THE GALION PROJECT", "Expertise Comptable") deviennent
// illisibles. Les wordmarks larges (Messika, Originator) gardent une hauteur plus
// basse : leur ratio (3.6 et 5.5) fait qu'ils occupent deja toute la largeur utile.
// Contrainte : largeur = h x ratio, plafonnee a 120 px par le max-width CSS.
// Pour ajouter un logo : viser ~68 px de haut si compact, sinon ajuster pour
// rester sous 120 px de large.
const logos = [
  { src: levisSrc,       alt: "Levi's — client NOCTA catering événementiel Paris",               h: 68, iw: 800,  ih: 800 },
  { src: biologiqueSrc,  alt: 'Biologique Recherche — client traiteur événementiel NOCTA',       h: 40, iw: 600,  ih: 208 },
  { src: galionSrc,      alt: "The Galion Project — événements d'entreprise NOCTA Paris",         h: 68, iw: 1024, ih: 1024 },
  { src: columbusSrc,    alt: "Colombus Consulting — cocktail et dîner d'entreprise NOCTA",       h: 65, iw: 1928, ih: 1771 },
  { src: jusMundiSrc,    alt: 'Jus Mundi — catering corporate Paris NOCTA',                       h: 68, iw: 1024, ih: 1024 },
  { src: aaConseilSrc,   alt: 'AA Conseil — traiteur corporate Paris NOCTA',                      h: 68, iw: 1024, ih: 1024 },
  { src: messikaSrc,     alt: 'Messika — client traiteur événementiel NOCTA Paris',               h: 25, iw: 509,  ih: 143 },
  { src: originatorSrc,  alt: 'Originator — client NOCTA catering événementiel Paris',            h: 20, iw: 360,  ih: 65 },
];
---

<section class="bg-nocta-cream border-t border-nocta-black/10 border-b py-16">
  <p class="t-eyebrow tracking-widest text-nocta-black/40 text-center mb-10">
    ILS NOUS FONT CONFIANCE
  </p>

  <div class="logo-slider-outer">
    <div class="logo-track">
      <!-- SET 1 -->
      {logos.map((logo) => (
        <div class="logo-item">
          <img src={logo.src} alt={logo.alt} width={logo.iw} height={logo.ih} style={`height: ${logo.h}px`} loading="lazy" draggable="false" />
        </div>
      ))}
      <!-- SET 2 — copie identique pour boucle seamless -->
      {logos.map((logo) => (
        <div class="logo-item" aria-hidden="true">
          <img src={logo.src} alt={logo.alt} width={logo.iw} height={logo.ih} style={`height: ${logo.h}px`} loading="lazy" draggable="false" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes scroll-logos {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .logo-slider-outer {
    overflow: hidden;
    width: 100%;
  }

  .logo-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: scroll-logos 30s linear infinite;
    isolation: isolate;
    will-change: transform;
  }

  .logo-track:hover {
    animation-play-state: paused;
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 70px;
    flex-shrink: 0;
  }

  .logo-item img {
    width: auto;
    max-width: 120px;
    object-fit: contain;
    opacity: 0.5;
    transition: opacity 0.3s ease;
    user-select: none;
    -webkit-user-drag: none;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .logo-item:hover img {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .logo-item {
      margin: 0 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      gap: 40px;
      padding: 0 24px;
    }
  }
</style>
