---
/**
 * Séquence photo d'une carte FORMATS (accueil) — « stop motion adouci ».
 *
 * Quatre photos existantes racontent un geste (du produit à la table). Chaque
 * image se pose — léger resserrement 1,035 → 1 — puis reste immobile ~2 s,
 * comme une image de stop motion ; la suivante arrive en fondu doux de 0,9 s.
 * Jamais de coupe sèche, jamais de saccade.
 *
 * Comportement (script ci-dessous, partagé par les trois cartes) :
 *   - démarre quand la carte entre dans l'écran, avec un décalage par carte
 *     (les trois cartes ne changent jamais d'image en même temps) ;
 *   - deux tours puis retour au repos sur la 1re image ; rejoue si la carte
 *     sort puis revient dans l'écran ;
 *   - pause au survol et au focus clavier de la carte, onglet masqué, ou
 *     carte hors écran ;
 *   - prefers-reduced-motion : la 1re image seule, fixe, aucune autre
 *     image téléchargée ;
 *   - sans JS : la 1re image seule.
 *
 * Poids : seule la 1re image est dans le HTML (loading="lazy") ; chaque image
 * suivante n'est demandée que pendant l'arrêt sur la précédente. Variantes
 * -400w / -800w existantes, aucune nouvelle image.
 *
 * Décoratif : aria-hidden, alt vide — la carte porte déjà son titre et son
 * lien. Opacité et transform uniquement.
 */
interface Frame {
  img: string;        // nom de base dans /images (variantes -400w / -800w)
  w: number;          // dimensions de la variante 800w
  h: number;
  pos?: string;       // object-position (cadrage dans la vignette 3:2)
}
interface Props {
  frames: Frame[];
  delay?: number;     // décalage de départ en ms
}
const { frames, delay = 0 } = Astro.props;
const sizes = '(min-width: 1024px) 22vw, 70vw';
const srcset = (f: Frame) => `/images/${f.img}-400w.webp 400w, /images/${f.img}-800w.webp 800w`;
---

<div class="fs" data-fs data-fs-delay={delay} aria-hidden="true">
  {frames.map((f, i) => i === 0 ? (
    <img
      class="fs-frame is-on"
      src={`/images/${f.img}-400w.webp`}
      srcset={srcset(f)}
      sizes={sizes}
      alt=""
      width={f.w}
      height={f.h}
      loading="lazy"
      decoding="async"
      style={f.pos ? `object-position: ${f.pos}` : undefined}
    />
  ) : (
    <img
      class="fs-frame"
      data-src={`/images/${f.img}-400w.webp`}
      data-srcset={srcset(f)}
      sizes={sizes}
      alt=""
      width={f.w}
      height={f.h}
      decoding="async"
      style={f.pos ? `object-position: ${f.pos}` : undefined}
    />
  ))}
</div>

<style>
  /* Vignette 3:2 en tête de carte. isolation : les z-index posés par le
     script restent internes à la vignette (cf. HeroPleinCadre). */
  .fs {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    isolation: isolate;
    margin-bottom: 2rem;
    background: #141414;
  }
  .fs-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.9s cubic-bezier(0.45, 0, 0.25, 1);
  }
  .fs-frame.is-on { opacity: 1; }

  /* La pose : l'image se resserre à peine en arrivant, puis s'immobilise. */
  @keyframes fs-pose {
    from { transform: scale(1.035); }
    to   { transform: none; }
  }
  .fs-frame.is-posing { animation: fs-pose 1.6s cubic-bezier(0.22, 1, 0.36, 1) both; }

  @media (prefers-reduced-motion: reduce) {
    .fs-frame { transition: none; }
    .fs-frame.is-posing { animation: none; }
  }
</style>

<script>
  const HOLD = 2200;     // arrêt sur chaque image (ms)
  const FADE = 900;      // fondu enchaîné (ms), aligné sur la transition CSS
  const CYCLES = 2;      // tours avant le retour au repos

  const rm = window.matchMedia('(prefers-reduced-motion: reduce)');

  interface Seq {
    root: HTMLElement;
    frames: HTMLImageElement[];
    index: number;
    steps: number;
    layer: number;
    delay: number;
    inView: boolean;
    held: boolean;      // survol ou focus de la carte
    started: boolean;
    timer?: ReturnType<typeof setTimeout>;
  }

  const seqs: Seq[] = Array.from(document.querySelectorAll<HTMLElement>('[data-fs]')).map((root) => ({
    root,
    frames: Array.from(root.querySelectorAll<HTMLImageElement>('.fs-frame')),
    index: 0,
    steps: 0,
    layer: 1,
    delay: Number(root.dataset.fsDelay || 0),
    inView: false,
    held: false,
    started: false,
  }));

  // Charge une image (data-src → src) ; résout quand elle est prête à
  // s'afficher, pour ne jamais fondre vers une vignette vide.
  function load(img: HTMLImageElement): Promise<void> {
    if (img.dataset.src) {
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      img.src = img.dataset.src;
      delete img.dataset.src;
      delete img.dataset.srcset;
    }
    return img.decode().catch(() => {});
  }

  const maxSteps = (s: Seq) => s.frames.length * CYCLES;
  const canRun = (s: Seq) => s.inView && !s.held && !document.hidden && !rm.matches && s.steps < maxSteps(s);

  function schedule(s: Seq, ms: number) {
    clearTimeout(s.timer);
    s.timer = setTimeout(() => step(s), ms);
    // L'image suivante se télécharge pendant l'arrêt sur l'image courante.
    load(s.frames[(s.index + 1) % s.frames.length]);
  }

  async function step(s: Seq) {
    if (!canRun(s)) return;                       // reprise par resume()
    const next = (s.index + 1) % s.frames.length;
    const incoming = s.frames[next];
    await load(incoming);
    if (!canRun(s)) return;
    const outgoing = s.frames[s.index];
    incoming.style.zIndex = String(++s.layer);    // l'entrante passe dessus
    incoming.classList.remove('is-posing');
    void incoming.offsetWidth;
    incoming.classList.add('is-on', 'is-posing');
    // L'ancienne s'efface une fois recouverte : pas de « trou » noir.
    setTimeout(() => { if (outgoing !== s.frames[s.index]) outgoing.classList.remove('is-on'); }, FADE);
    s.index = next;
    s.steps++;
    if (s.steps < maxSteps(s)) schedule(s, HOLD + FADE);
  }

  function resume(s: Seq) {
    if (!canRun(s)) { clearTimeout(s.timer); return; }
    schedule(s, s.started ? HOLD : s.delay + HOLD);
    s.started = true;
  }

  // Retour immédiat à la 1re image (préférence « animations réduites »).
  function rest(s: Seq) {
    clearTimeout(s.timer);
    s.frames.forEach((f, i) => { f.classList.toggle('is-on', i === 0); f.classList.remove('is-posing'); f.style.zIndex = ''; });
    s.index = 0;
  }

  if (seqs.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const s = seqs.find((x) => x.root === e.target);
        if (!s) continue;
        s.inView = e.isIntersecting;
        if (!s.inView && s.steps >= maxSteps(s)) { s.steps = 0; s.started = false; }  // rejouera au retour
        resume(s);
      }
    }, { threshold: 0.4 });

    for (const s of seqs) {
      io.observe(s.root);
      const card = s.root.closest('a');
      card?.addEventListener('mouseenter', () => { s.held = true;  resume(s); });
      card?.addEventListener('mouseleave', () => { s.held = false; resume(s); });
      card?.addEventListener('focusin',  () => { s.held = true;  resume(s); });
      card?.addEventListener('focusout', () => { s.held = false; resume(s); });
    }

    document.addEventListener('visibilitychange', () => seqs.forEach(resume));
    rm.addEventListener('change', () => seqs.forEach((s) => (rm.matches ? rest(s) : resume(s))));
  }
</script>
