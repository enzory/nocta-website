---
/**
 * PISTE A — « Éditorial » (maquette, labo uniquement)
 *
 * Idée : une page de magazine. Le titre devient l'image principale, posé en
 * très grand sur le cream #EEEBE3 ; la photo passe au second plan, en vignette
 * verticale cadrée, comme une illustration de couverture. Beaucoup d'air,
 * un filet fin, une seule photo.
 *
 * Contenus strictement identiques au hero actuel (exergue, H1, chapô, deux
 * boutons). Aucune promesse ni prix ajouté.
 *
 * Mouvement (CSS seul, une seule fois, jamais en boucle) :
 *   - le filet se trace de gauche à droite ;
 *   - « L'art de recevoir, » est là dès le premier affichage (LCP) ;
 *   - « sans compromis. » se pose mot à mot (.pose-mot, global.css) ;
 *   - la photo se découvre : un rideau cream glisse vers le haut pendant
 *     que l'image se resserre légèrement ;
 *   - chapô puis boutons en fondu doux.
 * Transform et opacity uniquement. Sous prefers-reduced-motion, tout est en
 * place d'emblée. Sans JS : rien ne change (aucun script ici).
 */
import ArrowRight from '../ArrowRight.astro';
---

<section id="hero" class="ed relative bg-nocta-cream text-nocta-black overflow-hidden">
  <div class="ed-grid max-w-7xl mx-auto px-6 lg:px-12">

    <div class="ed-folio">
      <p class="t-eyebrow">Paris, Île-de-France & ailleurs</p>
      <span class="ed-rule" aria-hidden="true"></span>
    </div>

    <h1 class="ed-title font-serif font-light">
      <span class="ed-l1">L’art de recevoir,</span>
      <em class="ed-l2"><span class="pose-mot" style="animation-delay: 0.1s">sans</span> <span class="pose-mot" style="animation-delay: 0.22s">compromis.</span></em>
    </h1>

    <div class="ed-photo">
      <img
        src="/images/nocta-pancetta-hero4-800w.webp"
        srcset="
          /images/nocta-pancetta-hero4-400w.webp   400w,
          /images/nocta-pancetta-hero4-800w.webp   800w,
          /images/nocta-pancetta-hero4-1200w.webp 1200w
        "
        sizes="(min-width: 1024px) 22vw, 92vw"
        alt="Pancetta croustillante dressée par le chef — catering événementiel Paris"
        width="800"
        height="1067"
        loading="eager"
        fetchpriority="high"
      />
      <span class="ed-curtain" aria-hidden="true"></span>
    </div>

    <div class="ed-foot">
      <p class="ed-chapo font-sans text-base lg:text-lg font-normal text-nocta-text leading-relaxed">
        NOCTA conçoit des expériences culinaires avec vous, pour les entreprises et les particuliers exigeants — à Paris, en Île-de-France et au-delà.
      </p>
      <div class="ed-actions">
        <a href="/contact" class="t-label inline-flex items-center justify-center bg-nocta-black text-nocta-cream px-8 py-3 transition-colors duration-300 hover:bg-nocta-ink">
          Demander un devis
        </a>
        <a href="/prestations" class="ed-link t-label inline-flex items-center gap-2 text-nocta-black">
          Explorer nos prestations
          <ArrowRight />
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Composition ─────────────────────────────────────────────────────
     Mobile : une colonne — exergue, titre, photo en bandeau 4:3, chapô,
     boutons. Tout tient dans 844 px de haut à 390 px de large.
     Desktop (≥ 1024 px) : grille de 12 colonnes. Titre sur toute la
     largeur, chapô et boutons en bas à gauche, photo verticale 4:5 en bas
     à droite (4 colonnes) — le blanc entre les deux fait la mise en page.
     L'italique décalée s'arrête avant le bord gauche de la photo. */
  .ed-grid {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: 6.5rem;   /* header fixe 80 px + respiration */
    padding-bottom: 2.5rem;
  }

  .ed-folio {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .ed-folio .t-eyebrow { white-space: nowrap; }
  .ed-rule {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.22;
    transform-origin: left center;
  }

  /* Titre : plus grand que .t-h1 (le titre EST le visuel de cette piste).
     Romain léger, approche serrée ; l'italique est décalée d'un cran vers
     la droite, comme une seconde ligne de couverture. */
  .ed-title {
    margin-top: 1.75rem;
    font-size: clamp(2.75rem, 8vw, 8.25rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .ed-l1, .ed-l2 { display: block; }
  .ed-l2 { padding-left: 0.6em; }

  .ed-photo {
    position: relative;
    margin-top: 1.75rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #d9d5cc; /* teinte d'attente sous l'image, proche du cream */
  }
  .ed-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }
  .ed-curtain {
    position: absolute;
    inset: 0;
    background: #EEEBE3;
    transform: translateY(-101%); /* état final : rideau sorti par le haut */
  }

  .ed-foot { margin-top: 1.5rem; }
  .ed-chapo { max-width: 44ch; }
  .ed-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
  }
  .ed-actions > a:first-child { min-height: 48px; }

  /* Lien secondaire : texte souligné d'un filet qui se tend au survol. */
  .ed-link {
    min-height: 44px;
    justify-content: center;
    position: relative;
  }
  .ed-link::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 10px;
    width: 0;
    height: 1px;
    background: currentColor;
    transform: translateX(-50%);
    transition: width 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ed-link:hover::after,
  .ed-link:focus-visible::after { width: 100%; }

  @media (min-width: 1024px) {
    .ed-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto 1fr auto;
      column-gap: 1.5rem;
      padding-top: 7rem;
      padding-bottom: 3rem;
    }
    .ed-folio { grid-column: 1 / -1; grid-row: 1; }
    .ed-title { grid-column: 1 / -1; grid-row: 2; margin-top: 2.25rem; }
    /* La photo part du bas et peut remonter jusque sous la 2e ligne du
       titre (qui s'arrête avant elle) ; sa hauteur suit la fenêtre pour ne
       jamais pousser le hero au-delà de l'écran. */
    .ed-photo {
      grid-column: 9 / -1;
      grid-row: 2 / 5;
      align-self: end;
      margin-top: 0;
      aspect-ratio: auto;
      height: min(33vw, calc(100svh - 24rem));
    }
    .ed-foot {
      grid-column: 1 / 7;
      grid-row: 4;
      align-self: end;
      margin-top: 0;
    }
    .ed-actions {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
    .ed-link { justify-content: flex-start; }
    .ed-link::after { left: 0; transform: none; }
  }

  /* ── Entrée — une seule fois ────────────────────────────────────────── */
  @keyframes ed-trace {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @keyframes ed-rideau {
    from { transform: translateY(0); }
    to   { transform: translateY(-101%); }
  }
  @keyframes ed-resserre {
    from { transform: scale(1.08); }
    to   { transform: none; }
  }

  .ed-rule    { animation: ed-trace 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.05s both; }
  .ed-curtain { animation: ed-rideau 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.25s both; }
  .ed-photo img { animation: ed-resserre 1.6s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both; }
  .ed-chapo   { --rise: 10px; animation: fondu-montee 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.45s both; }
  .ed-actions { --rise: 10px; animation: fondu-montee 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.6s both; }

  @media (prefers-reduced-motion: reduce) {
    .ed-rule, .ed-curtain, .ed-photo img, .ed-chapo, .ed-actions { animation: none; }
    .ed-link::after { transition: none; }
  }
</style>
