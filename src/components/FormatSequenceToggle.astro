---
/**
 * Bouton pause / lecture des séquences photo FORMATS (WCAG 2.2.2).
 *
 * Un bouton par carte, dans le coin haut droit de la vignette : visible là
 * où l'image bouge, y compris sur mobile où les cartes sont empilées. Les
 * trois boutons pilotent la MÊME pause (un clic calme toute la section) et
 * affichent le même état. Logique dans FormatSequence.astro.
 *
 * Placé à côté du lien de la carte, jamais dedans : un <button> dans un <a>
 * est invalide et le clic ouvrirait la page. Le conteneur de la carte
 * (data-fs-card, position relative) superpose les deux.
 *
 * Masqué par défaut (hidden) : le script ne l'affiche que si l'animation
 * peut tourner. Sans JS ou sous prefers-reduced-motion, l'image est fixe et
 * le bouton n'a pas lieu d'être.
 */
interface Props {
  delay?: string;     // même transition-delay que la carte (apparition reveal)
}
const { delay = '0s' } = Astro.props;
---

<button
  type="button"
  class="fs-toggle reveal"
  data-fs-toggle
  hidden
  aria-label="Mettre l'animation en pause"
  title="Mettre l'animation en pause"
  style={`transition-delay: ${delay}`}
>
  <svg data-icon="pause" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2.5" y="1.5" width="1.6" height="9" rx="0.3"/><rect x="7.9" y="1.5" width="1.6" height="9" rx="0.3"/></svg>
  <svg data-icon="play" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true" hidden><path d="M3 1.8 10 6 3 10.2Z"/></svg>
</button>

<style>
  /* Coin haut droit de la vignette : la carte a 2,5 rem de marge intérieure
     (p-10) à toutes les tailles ; 0,5 rem de retrait dans la photo. Crème sur
     noir translucide, filet fin : discret, lisible sur la photo la plus claire. */
  .fs-toggle {
    position: absolute;
    top: 3rem;
    right: 3rem;
    z-index: 2;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #EEEBE3;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(238, 235, 227, 0.35);
    cursor: pointer;
    /* opacity / transform : celles de .reveal (apparition avec la carte),
       redéclarées ici pour ne pas être écrasées par les couleurs. */
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease,
      border-color 0.3s ease;
  }
  .fs-toggle[hidden] { display: none; }
  .fs-toggle:hover,
  .fs-toggle:focus-visible {
    background: rgba(0, 0, 0, 0.78);
    border-color: #EEEBE3;
  }
  .fs-toggle:focus-visible {
    outline: 2px solid #EEEBE3;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-toggle { display: none; }
  }
</style>
