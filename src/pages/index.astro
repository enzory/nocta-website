---
import Layout from '../layouts/layout.astro';
import Header from '../components/header.astro';
import Footer from '../components/Footer.astro';
import CallToAction from '../components/CallToAction.astro';
import LogoSlider from '../components/LogoSlider.astro';
import HeroPleinCadre from '../components/HeroPleinCadre.astro';
import FormatSequence from '../components/FormatSequence.astro';
import FormatSequenceToggle from '../components/FormatSequenceToggle.astro';

// Séquences photo des cartes FORMATS (cf. components/FormatSequence.astro) :
// quatre images existantes par format, du produit à la table.
// w / h = dimensions des variantes 800w.
const sequences = {
  private: [
    { img: 'produit-tomate-maison', w: 800, h: 1067 },
    { img: 'dressage-signature', w: 800, h: 1000 },
    { img: 'nocta-bouche-private', w: 800, h: 846 },
    { img: 'bougie-bois-maison', w: 800, h: 1006 },
  ],
  corporate: [
    { img: 'nocta-table-corporate-apm', w: 800, h: 1067 },
    { img: 'nocta-corporate-enzo', w: 800, h: 955, pos: '50% 12%' },   // visage dans le cadre
    { img: 'nocta-amuses-bouches', w: 800, h: 1067 },
    { img: 'reception-levis-corporate', w: 800, h: 458 },
  ],
  signature: [
    { img: 'salon-signature', w: 800, h: 1067 },
    { img: 'nocta-table-haussmann', w: 800, h: 1094 },
    { img: 'sommellerie-verres-vin', w: 800, h: 600 },
    { img: 'nocta-plat-signature-hermes', w: 800, h: 600 },
  ],
};
---

<Layout
  title="Traiteur événementiel à Paris — Chef privé | NOCTA"
  description="Traiteur événementiel à Paris et Île-de-France : chef privé, cocktails, dîners corporate. Formés en cuisine étoilée. Devis gratuit sous 24 h."
  preloadHero={{
    href: "/images/nocta-assiette-hero1-400w.webp",
    srcset: "/images/nocta-assiette-hero1-400w.webp 400w, /images/nocta-assiette-hero1-800w.webp 800w, /images/nocta-assiette-hero1-1200w.webp 1200w, /images/nocta-assiette-hero1.webp 2400w",
    sizes: "100vw"
  }}
>
  <Header />

  <main id="contenu">

    <!-- HERO — plein cadre : trois photos en fondu lent, titre et bandeau
         (cf. components/HeroPleinCadre.astro) -->
    <HeroPleinCadre />

    <!-- Bandeau preuve sociale (post-hero, avant éditorial) -->
    <!-- Discret et factuel : la section CONFIANCE détaillée reste plus bas (3 stats + 25 ans cumulés). -->
    <section class="bg-nocta-cream border-b border-nocta-black/10 py-5">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 text-center">
        <a
          href="https://g.page/r/CQOWoTg-G7diEBE/review"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-nocta-black hover:opacity-70 transition-opacity duration-200"
          aria-label="Avis Google : 5 sur 5"
        >
          <span class="flex items-center gap-0.5" aria-hidden="true">
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </span>
          <span class="font-sans text-xs sm:text-sm font-normal tracking-wide"><strong class="font-medium">5/5 sur Google</strong></span>
        </a>
        <span class="hidden sm:inline-block w-px h-4 bg-nocta-black/20" aria-hidden="true"></span>
        <p class="font-sans text-xs sm:text-sm font-normal text-nocta-grey">
          Plus de 50 événements réalisés à Paris et en Île-de-France
        </p>
      </div>
    </section>

    <!-- FORMATS -->
    <section class="bg-nocta-black py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between mb-12 reveal">
          <div>
            <p class="t-eyebrow text-nocta-cream/40 mb-4">Nos formats</p>
            <h2 class="t-h2 text-nocta-cream">
              Trois formats, une seule exigence.
            </h2>
          </div>
          <a href="/prestations" class="t-label mt-8 lg:mt-0 text-nocta-cream/60 hover:text-nocta-cream transition-colors duration-300 flex items-center gap-3">
            Voir toutes les prestations
            <span class="w-8 h-px bg-current inline-block"></span>
          </a>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-nocta-cream/10">
          <div class="relative grid" data-fs-card>
            <a href="/prestations/private" class="group block bg-nocta-black p-10 hover:bg-nocta-cream/5 transition-all duration-500 reveal" style="transition-delay: 0.1s">
              <FormatSequence frames={sequences.private} delay={0} />
              <p class="t-eyebrow text-nocta-cream/40 mb-8">01</p>
              <h3 class="t-h3 text-3xl text-nocta-cream mb-4 group-hover:text-white transition-colors">NOCTA Private</h3>
              <p class="font-sans text-sm font-normal leading-relaxed text-nocta-cream/50 mb-10">
                Dîners à domicile, anniversaires, célébrations familiales. Nous prenons en charge l’intégralité — pour que vous soyez présent à vos invités, pas à votre cuisine.
              </p>
              <span class="t-label text-nocta-cream/30 group-hover:text-nocta-cream/60 transition-colors flex items-center gap-3">
                Découvrir
                <span class="w-6 h-px bg-current inline-block group-hover:w-10 transition-all duration-300"></span>
              </span>
            </a>
            <FormatSequenceToggle delay="0.1s" />
          </div>
          <div class="relative grid" data-fs-card>
            <a href="/prestations/corporate" class="group block bg-nocta-black p-10 hover:bg-nocta-cream/5 transition-all duration-500 reveal" style="transition-delay: 0.2s">
              <FormatSequence frames={sequences.corporate} delay={700} />
              <p class="t-eyebrow text-nocta-cream/40 mb-8">02</p>
              <h3 class="t-h3 text-3xl text-nocta-cream mb-4 group-hover:text-white transition-colors">NOCTA Corporate</h3>
              <p class="font-sans text-sm font-normal leading-relaxed text-nocta-cream/50 mb-10">
                Cocktails de lancement, dîners de gala, comités de direction. Une gastronomie à la hauteur de l’image que vous souhaitez donner.
              </p>
              <span class="t-label text-nocta-cream/30 group-hover:text-nocta-cream/60 transition-colors flex items-center gap-3">
                Découvrir
                <span class="w-6 h-px bg-current inline-block group-hover:w-10 transition-all duration-300"></span>
              </span>
            </a>
            <FormatSequenceToggle delay="0.2s" />
          </div>
          <div class="relative grid" data-fs-card>
            <a href="/prestations/signature" class="group block bg-nocta-black p-10 hover:bg-nocta-cream/5 transition-all duration-500 reveal" style="transition-delay: 0.3s">
              <FormatSequence frames={sequences.signature} delay={1400} />
              <p class="t-eyebrow text-nocta-cream/40 mb-8">03</p>
              <h3 class="t-h3 text-3xl text-nocta-cream mb-4 group-hover:text-white transition-colors">NOCTA Signature</h3>
              <p class="font-sans text-sm font-normal leading-relaxed text-nocta-cream/50 mb-10">
                Un format où cuisine, vins et scénographie composent une expérience cohérente de bout en bout.
              </p>
              <span class="t-label text-nocta-cream/30 group-hover:text-nocta-cream/60 transition-colors flex items-center gap-3">
                Découvrir
                <span class="w-6 h-px bg-current inline-block group-hover:w-10 transition-all duration-300"></span>
              </span>
            </a>
            <FormatSequenceToggle delay="0.3s" />
          </div>
        </div>
      </div>
    </section>

    <LogoSlider />

    <!-- APPROCHE -->
    <section class="bg-nocta-cream pt-24 lg:pt-36 pb-8 lg:pb-12">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="max-w-2xl mb-14 reveal">
          <p class="t-eyebrow text-nocta-grey mb-4">Notre approche</p>
          <h2 class="t-h2 text-nocta-black">
            Gastronomie, service, sommellerie.
          </h2>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-8">
          <div class="reveal" style="transition-delay: 0.1s">
            <div class="w-8 h-px bg-nocta-black mb-8"></div>
            <h3 class="t-h3 text-nocta-black mb-4">La cuisine</h3>
            <p class="font-sans text-sm font-normal leading-relaxed text-nocta-grey">
              Hugo et son équipe sont formés dans les cuisines étoilées. Chaque menu est construit avec soin, chaque produit sélectionné pour ce qu’il est — pas pour ce qu’il représente.
            </p>
          </div>
          <div class="reveal" style="transition-delay: 0.2s">
            <div class="w-8 h-px bg-nocta-black mb-8"></div>
            <h3 class="t-h3 text-nocta-black mb-4">Le service</h3>
            <p class="font-sans text-sm font-normal leading-relaxed text-nocta-grey">
              Un bon repas se joue autant en salle qu’en cuisine. Gestuelle, rythme, attention discrète : nous maîtrisons ces codes depuis le premier jour.
            </p>
          </div>
          <div class="reveal" style="transition-delay: 0.3s">
            <div class="w-8 h-px bg-nocta-black mb-8"></div>
            <h3 class="t-h3 text-nocta-black mb-4">La sommellerie</h3>
            <p class="font-sans text-sm font-normal leading-relaxed text-nocta-grey">
              Enzo compose chaque sélection de vins en fonction du menu, du moment et des personnes autour de la table. Pas une liste — une ligne directrice.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PHOTO GALLERY -->
    <section class="bg-nocta-cream py-24 lg:py-36">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">

        <div class="mb-16 reveal">
          <p class="t-eyebrow text-nocta-grey mb-4">Nos réalisations</p>
          <h2 class="t-h2 text-nocta-black">
            Chaque événement,<br/>une signature.
          </h2>
          <p class="font-sans text-sm font-normal text-nocta-grey mt-4">Quelques tables que nous avons dressées.</p>
        </div>

        <div class="gallery-masonry">

          <!-- 1 — Poireau (existante) -->
          <div class="gallery-item reveal">
            <a href="/images/nocta-assiette-poireau.webp" class="glightbox block overflow-hidden" data-gallery="nocta">
              <img src="/images/nocta-assiette-poireau-800w.webp"
                srcset="/images/nocta-assiette-poireau-400w.webp 400w, /images/nocta-assiette-poireau-800w.webp 800w, /images/nocta-assiette-poireau.webp 1355w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="Assiette poireau vinaigrette — dîner privé Paris"
                width="800" height="945" loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 ease-out hover:scale-105" />
            </a>
          </div>

          <!-- 2 — Foie gras (NOUVELLE) -->
          <div class="gallery-item reveal">
            <a href="/images/nocta-foie-gras.webp" class="glightbox block overflow-hidden" data-gallery="nocta">
              <img src="/images/nocta-foie-gras-800w.webp"
                srcset="/images/nocta-foie-gras-400w.webp 400w, /images/nocta-foie-gras-800w.webp 800w, /images/nocta-foie-gras.webp 1200w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="Foie gras mi-cuit dressé sur porcelaine — dîner gastronomique NOCTA Paris"
                width="1200" height="1600" loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 ease-out hover:scale-105" />
            </a>
          </div>

          <!-- 3 — Céleri marché (existante) -->
          <div class="gallery-item reveal">
            <a href="/images/nocta-oeuf-truite-bouchees.webp" class="glightbox block overflow-hidden" data-gallery="nocta">
              <img src="/images/nocta-oeuf-truite-bouchees-800w.webp"
                srcset="/images/nocta-oeuf-truite-bouchees-400w.webp 400w, /images/nocta-oeuf-truite-bouchees-800w.webp 800w, /images/nocta-oeuf-truite-bouchees-1200w.webp 1200w, /images/nocta-oeuf-truite-bouchees.webp 1535w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="Bouchées avocat et œufs de truite, fleur de ciboulette — cocktail traiteur Paris"
                width="800" height="800" loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 ease-out hover:scale-105" />
            </a>
          </div>

          <!-- 4 — Velouté Dubarry (NOUVELLE) -->
          <div class="gallery-item reveal">
            <a href="/images/nocta-pavlova-fraise.webp" class="glightbox block overflow-hidden" data-gallery="nocta">
              <img src="/images/nocta-pavlova-fraise-800w.webp"
                srcset="/images/nocta-pavlova-fraise-400w.webp 400w, /images/nocta-pavlova-fraise-800w.webp 800w, /images/nocta-pavlova-fraise-1200w.webp 1200w, /images/nocta-pavlova-fraise.webp 1536w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="Pavlova fraise et fleurs comestibles sur porcelaine — dessert traiteur NOCTA Paris"
                width="800" height="1067" loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 ease-out hover:scale-105" />
            </a>
          </div>

          <!-- 5 — Madeleine canelé (existante) -->
          <div class="gallery-item reveal">
            <a href="/images/nocta-carottes-tomates-bols.webp" class="glightbox block overflow-hidden" data-gallery="nocta">
              <img src="/images/nocta-carottes-tomates-bols-800w.webp"
                srcset="/images/nocta-carottes-tomates-bols-400w.webp 400w, /images/nocta-carottes-tomates-bols-800w.webp 800w, /images/nocta-carottes-tomates-bols.webp 1200w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="Entrée carottes et tomates en bols de grès — dîner privé Paris"
                width="800" height="1067" loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 ease-out hover:scale-105" />
            </a>
          </div>

          <!-- 6 — Main Hugo cuisine (NOUVELLE) -->
          <div class="gallery-item reveal">
            <a href="/images/nocta-main-hugo-cuisine.webp" class="glightbox block overflow-hidden" data-gallery="nocta">
              <img src="/images/nocta-main-hugo-cuisine-800w.webp"
                srcset="/images/nocta-main-hugo-cuisine-400w.webp 400w, /images/nocta-main-hugo-cuisine-800w.webp 800w, /images/nocta-main-hugo-cuisine.webp 1073w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="Chef Hugo en cuisine — préparation coquillages et herbes NOCTA"
                width="1073" height="1600" loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 ease-out hover:scale-105" />
            </a>
          </div>

          <!-- 7 — Tomate (existante) -->
          <div class="gallery-item reveal">
            <a href="/images/nocta-assiette-tomate.webp" class="glightbox block overflow-hidden" data-gallery="nocta">
              <img src="/images/nocta-assiette-tomate-800w.webp"
                srcset="/images/nocta-assiette-tomate-400w.webp 400w, /images/nocta-assiette-tomate-800w.webp 800w, /images/nocta-assiette-tomate.webp 2400w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="Assiette tomate ancienne — catering gastronomique Paris"
                width="800" height="1067" loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 ease-out hover:scale-105" />
            </a>
          </div>

          <!-- 8 — Amuses-bouches (NOUVELLE) -->
          <div class="gallery-item reveal">
            <a href="/images/nocta-service-buffet.webp" class="glightbox block overflow-hidden" data-gallery="nocta">
              <img src="/images/nocta-service-buffet-800w.webp"
                srcset="/images/nocta-service-buffet-400w.webp 400w, /images/nocta-service-buffet-800w.webp 800w, /images/nocta-service-buffet.webp 1200w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="Maître d'hôtel dressant le buffet — service traiteur événementiel Paris"
                width="800" height="1067" loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 ease-out hover:scale-105" />
            </a>
          </div>

          <!-- 9 — Mousse au chocolat (NOUVELLE) -->
          <div class="gallery-item reveal">
            <a href="/images/nocta-striures-courgette.webp" class="glightbox block overflow-hidden" data-gallery="nocta">
              <img src="/images/nocta-striures-courgette-800w.webp"
                srcset="/images/nocta-striures-courgette-400w.webp 400w, /images/nocta-striures-courgette-800w.webp 800w, /images/nocta-striures-courgette-1200w.webp 1200w, /images/nocta-striures-courgette.webp 1492w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="Bouchées aux striures de courgette — cocktail gastronomique NOCTA Paris"
                width="800" height="800" loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 ease-out hover:scale-105" />
            </a>
          </div>

          <!-- 10 — Saint-Tropez petit-déjeuner (existante) -->
          <div class="gallery-item reveal">
            <a href="/images/nocta-asperge-agrume.webp" class="glightbox block overflow-hidden" data-gallery="nocta">
              <img src="/images/nocta-asperge-agrume-800w.webp"
                srcset="/images/nocta-asperge-agrume-400w.webp 400w, /images/nocta-asperge-agrume-800w.webp 800w, /images/nocta-asperge-agrume.webp 1200w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="Asperges vertes et agrumes sur porcelaine à filet or — dîner gastronomique NOCTA Paris"
                width="800" height="1056" loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 ease-out hover:scale-105" />
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- CONFIANCE -->
    <section class="bg-nocta-cream pb-24 lg:pb-36">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="border-t border-nocta-black/10 pt-16">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 lg:gap-8 text-center">
            <div class="reveal" style="transition-delay: 0.1s">
              <p class="font-serif text-4xl lg:text-5xl font-light text-nocta-black mb-3">50+</p>
              <p class="font-sans text-sm font-normal text-nocta-grey">événements réalisés</p>
            </div>
            <div class="reveal" style="transition-delay: 0.2s">
