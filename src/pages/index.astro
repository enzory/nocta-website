  .gallery-item.reveal {
    transform: none;
    transition: none;
  }
  .gallery-item.reveal.visible {
    --rise: 12px;
    animation: fondu-montee 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .gallery-item.reveal.visible:nth-child(3n + 2) { animation-delay: 0.1s; }
  .gallery-item.reveal.visible:nth-child(3n)     { animation-delay: 0.2s; }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item.reveal.visible { animation: none; }
  }
</style>

