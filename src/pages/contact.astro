---
/*
  /contact — Demande de devis : la « Fiche de réception » NOCTA en production.
  - Vrai envoi Formspree (même formulaire qu'avant : f/maqpwebj), mêmes champs,
    mêmes règles, objet d'email et page d'origine conservés.
  - Après envoi confirmé : tampon « Demande reçue », puis page /merci
    (étape suivie par GTM / GA4, comme avec l'ancien formulaire).
  - Sans JavaScript : envoi classique, retour sur /merci.
  La fiche : src/components/FicheReception.astro. Sa démo : /apercu/fiche-reception.
*/
import Layout from '../layouts/layout.astro';
import Header from '../components/header.astro';
import Footer from '../components/Footer.astro';
import FicheReception from '../components/FicheReception.astro';
---

<Layout
  title="Contact — Demande de devis Traiteur Paris | NOCTA"
  description="Demandez un devis à NOCTA, traiteur et chef privé à Paris. Événement privé ou corporate en Île-de-France et La Défense — réponse sous 24 heures."
>
  <Header light />
  <FicheReception />
  <Footer />
</Layout>
