---
import Layout from '../layouts/layout.astro';
import Header from '../components/header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Merci — NOCTA"
  description="Votre demande a bien été envoyée. Nous revenons vers vous dans les 48 heures."
  noindex
>
  <Header />

  <main class="bg-nocta-black min-h-screen min-h-svh flex flex-col items-center justify-center px-6 text-center">

    <p class="t-eyebrow font-normal text-nocta-cream/40 mb-8 animate-fade-up" style="animation-delay: 0.1s; opacity: 0;">
      Merci
    </p>

    <h1 class="t-h1 lg:text-6xl xl:text-6xl text-nocta-cream mb-6 max-w-2xl animate-fade-up" style="animation-delay: 0.25s; opacity: 0;">
      Votre demande a bien été envoyée.
    </h1>

    <p class="font-sans text-base lg:text-lg font-normal text-nocta-cream/50 mb-14 animate-fade-up" style="animation-delay: 0.4s; opacity: 0;">
      Nous revenons vers vous dans les 48 heures.
    </p>

    <a
      href="/"
      class="t-label inline-flex items-center border border-nocta-cream/40 text-nocta-cream px-10 py-4 hover:border-nocta-cream hover:bg-nocta-cream hover:text-nocta-black transition-all duration-300 animate-fade-up"
      style="animation-delay: 0.55s; opacity: 0;"
    >
      Retourner à l’accueil
    </a>

  </main>

  <Footer />
</Layout>
