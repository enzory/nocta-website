---
// ============================================================
// src/pages/traiteur/[slug].astro
// Template pour les pages GEO auto-générées.
// ============================================================
// Lit la Content Collection "geo" (src/content/geo/*.md).
// Rend un layout cream identique au Journal, avec un Schema
// LocalBusiness ou Service selon le champ `schemaType` du
// frontmatter.
// ============================================================

import { getCollection } from 'astro:content';
import Layout from '../../layouts/layout.astro';
import Header from '../../components/header.astro';
import Footer from '../../components/Footer.astro';

// Génère une page statique par entrée de la collection "geo"
export async function getStaticPaths() {
  const entries = await getCollection('geo');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

// Construction du Schema.org selon le type
const siteUrl = 'https://www.noctaparis.fr';
// Astro 5 : `entry.slug` est déprécié au profit de `entry.id`. On dérive le
// slug d'URL depuis l'id (nom de fichier sans extension) partout.
const slugOf = (e) => e.id.replace(/\.md$/, '');
const entrySlug = slugOf(entry);
const pageUrl = `${siteUrl}/traiteur/${entrySlug}`;

const allGeo = await getCollection('geo');

// ------------------------------------------------------------
// « Nos autres zones d'intervention » — table d'adjacence EXPLICITE.
// Volontairement écrite à la main plutôt que dérivée d'un tri :
// une liste générée (ex. « les 2 dernières pages publiées ») produit le même
// bloc de liens sur les 30 pages, donc un signal de duplication. Ici chaque
// page a sa propre liste.
//
// Règles par `type` :
//   arrondissement → arrondissements réellement limitrophes (+ communes du 92
//                    réellement frontalières pour les 16e et 17e)
//   commune-92     → communes voisines + au moins un lien Paris
//   occasion       → 3 autres occasions + 1 zone pertinente
//   chef-prive     → autres pages chef-prive + l'arrondissement correspondant
//
// Le titre de section dit « autres zones d'intervention », pas « limitrophes » :
// Courbevoie et Puteaux ne bordent pas Paris (Neuilly s'interpose), mais pointent
// vers les 17e et 8e pour relier la grappe 92 à la grappe parisienne — continuité
// de l'axe d'affaires La Défense / Champs-Élysées. Rien n'y est présenté comme
// une adjacence géographique.
//
// Les arrondissements sans page GEO (5e, 10e-14e, 18e-20e) sont absents du
// silo : certaines listes comptent donc 2 ou 3 entrées au lieu de 4. On
// préfère une liste courte et juste à un remplissage géographiquement faux.
// ------------------------------------------------------------
const adjacency = {
  // --- arrondissements ---
  'traiteur-paris-1':  ['traiteur-paris-2', 'traiteur-paris-4', 'traiteur-paris-6', 'traiteur-paris-8'],
  'traiteur-paris-2':  ['traiteur-paris-1', 'traiteur-paris-3', 'traiteur-paris-9'],
  'traiteur-paris-3':  ['traiteur-paris-1', 'traiteur-paris-2', 'traiteur-paris-4'],
  'traiteur-paris-4':  ['traiteur-paris-1', 'traiteur-paris-3'],
  'traiteur-paris-6':  ['traiteur-paris-1', 'traiteur-paris-7', 'traiteur-paris-15'],
  'traiteur-paris-7':  ['traiteur-paris-6', 'traiteur-paris-8', 'traiteur-paris-15', 'traiteur-paris-16'],
  'traiteur-paris-8':  ['traiteur-paris-1', 'traiteur-paris-9', 'traiteur-paris-16', 'traiteur-paris-17'],
  // paris-1 retiré : le contact 1er/9e se fait en un point vers l'Opéra, trop
  // faible pour être présenté comme limitrophe (paris-1 ne listait déjà pas le 9e).
  'traiteur-paris-9':  ['traiteur-paris-2', 'traiteur-paris-8', 'traiteur-paris-17'],
  'traiteur-paris-15': ['traiteur-paris-6', 'traiteur-paris-7', 'traiteur-paris-16'],
  // 16e et 17e : seuls arrondissements du silo à border réellement le 92.
  'traiteur-paris-16': ['traiteur-paris-7', 'traiteur-paris-8', 'traiteur-paris-15', 'traiteur-paris-17', 'traiteur-boulogne-billancourt'],
  'traiteur-paris-17': ['traiteur-paris-8', 'traiteur-paris-9', 'traiteur-paris-16', 'traiteur-levallois-perret', 'traiteur-neuilly-sur-seine'],

  // --- communes des Hauts-de-Seine (chacune porte au moins un lien Paris) ---
  // Courbevoie et Puteaux ne bordent pas Paris : les liens 17e/8e sont une
  // continuité d'axe d'affaires, pas une adjacence.
  'traiteur-courbevoie-la-defense': ['traiteur-puteaux', 'traiteur-neuilly-sur-seine', 'traiteur-levallois-perret', 'traiteur-paris-17', 'traiteur-paris-8'],
  'traiteur-puteaux':               ['traiteur-courbevoie-la-defense', 'traiteur-neuilly-sur-seine', 'traiteur-paris-17', 'traiteur-paris-8'],
  'traiteur-levallois-perret':      ['traiteur-neuilly-sur-seine', 'traiteur-courbevoie-la-defense', 'traiteur-paris-17'],
  'traiteur-neuilly-sur-seine':     ['traiteur-levallois-perret', 'traiteur-courbevoie-la-defense', 'traiteur-paris-16', 'traiteur-paris-17'],
  'traiteur-boulogne-billancourt':  ['traiteur-paris-16', 'chef-prive-boulogne-billancourt'],

  // --- occasions : 3 autres occasions + 1 zone pertinente ---
  'traiteur-anniversaire-paris':        ['traiteur-cremaillere-paris', 'traiteur-fiancailles-paris', 'traiteur-depart-retraite-paris', 'traiteur-paris-16'],
  'traiteur-bapteme-paris':             ['traiteur-fiancailles-paris', 'traiteur-cremaillere-paris', 'traiteur-anniversaire-paris', 'traiteur-neuilly-sur-seine'],
  'traiteur-cremaillere-paris':         ['traiteur-anniversaire-paris', 'traiteur-bapteme-paris', 'traiteur-inauguration-paris', 'traiteur-paris-15'],
  'traiteur-fiancailles-paris':         ['traiteur-anniversaire-paris', 'traiteur-bapteme-paris', 'traiteur-vernissage-paris', 'traiteur-paris-7'],
  'traiteur-cocktail-entreprise-paris': ['traiteur-inauguration-paris', 'traiteur-seminaire-paris', 'traiteur-vernissage-paris', 'traiteur-courbevoie-la-defense'],
  'traiteur-depart-retraite-paris':     ['traiteur-cocktail-entreprise-paris', 'traiteur-inauguration-paris', 'traiteur-anniversaire-paris', 'traiteur-paris-8'],
  'traiteur-inauguration-paris':        ['traiteur-vernissage-paris', 'traiteur-cocktail-entreprise-paris', 'traiteur-seminaire-paris', 'traiteur-paris-1'],
  'traiteur-seminaire-paris':           ['traiteur-cocktail-entreprise-paris', 'traiteur-depart-retraite-paris', 'traiteur-inauguration-paris', 'traiteur-puteaux'],
  'traiteur-vernissage-paris':          ['traiteur-inauguration-paris', 'traiteur-cocktail-entreprise-paris', 'traiteur-cremaillere-paris', 'traiteur-paris-3'],

  // --- chef privé : autres pages chef-prive + l'arrondissement/commune correspondant ---
  'chef-prive-paris-7':               ['chef-prive-paris-8', 'chef-prive-paris-16', 'chef-prive-neuilly-sur-seine', 'traiteur-paris-7'],
  'chef-prive-paris-8':               ['chef-prive-paris-16', 'chef-prive-paris-7', 'chef-prive-neuilly-sur-seine', 'traiteur-paris-8'],
  'chef-prive-paris-16':              ['chef-prive-paris-7', 'chef-prive-paris-8', 'chef-prive-boulogne-billancourt', 'traiteur-paris-16'],
  'chef-prive-neuilly-sur-seine':     ['chef-prive-paris-16', 'chef-prive-paris-8', 'chef-prive-paris-7', 'traiteur-neuilly-sur-seine'],
  'chef-prive-boulogne-billancourt':  ['chef-prive-paris-16', 'chef-prive-neuilly-sur-seine', 'chef-prive-paris-7', 'traiteur-boulogne-billancourt'],
};

// Résolution des slugs -> entrées de collection. Un slug absent de la
// collection est ignoré silencieusement (pas de lien mort au build).
const geoBySlug = new Map(allGeo.map((p) => [slugOf(p), p]));
const neighbours = (adjacency[entrySlug] ?? [])
  .map((s) => geoBySlug.get(s))
  .filter(Boolean);

// areaServed : array si fourni (Sprint B), sinon fallback sur la zone
const areaServedValue = d.areaServed?.length
  ? d.areaServed.map((name) => ({ '@type': 'Place', name }))
  : { '@type': 'Place', name: d.zone };

const baseAddress = {
  '@type': 'PostalAddress',
  addressLocality: 'Courbevoie',
  addressRegion: 'Île-de-France',
  addressCountry: 'FR',
  ...(d.streetAddress ? { streetAddress: d.streetAddress, postalCode: '92400' } : {}),
};

const schema =
  d.schemaType === 'LocalBusiness'
    ? {
        '@context': 'https://schema.org',
        '@type': 'CateringService',
        name: `NOCTA Catering — ${d.zone}`,
        description: d.description,
        url: pageUrl,
        image: `${siteUrl}/images/og-image.jpeg`,
        areaServed: areaServedValue,
        address: baseAddress,
        priceRange: '€€€',
        serviceType: 'Traiteur événementiel parisien',
        servesCuisine: 'Cuisine événementielle française',
        potentialAction: {
          '@type': 'ReserveAction',
          target: `${siteUrl}/contact`,
          name: 'Demander un devis',
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: d.title,
        description: d.description,
        url: pageUrl,
        provider: {
          '@type': 'Organization',
          name: 'NOCTA Catering',
          url: siteUrl,
        },
        areaServed: areaServedValue,
      };

// Sprint B — FAQPage si frontmatter `faq` présent (max chances de rich snippet)
const faqSchema = d.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((q) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: q.answer,
        },
      })),
    }
  : null;

// H1 affiché : `h1` du frontmatter en priorité (plus court, lisible),
// sinon `title` (servant aussi pour <title> SEO).
const displayH1 = d.h1 ?? d.title;

// `zone` est un libellé calibré pour l'eyebrow (« Zone desservie · Paris 8e
// arrondissement »), pas un complément de lieu : collé derrière « à », il produit
// « à Paris 8e arrondissement ». Cette fonction en fait une locution insérable.
const placePhrase = (zone) => {
  // « Courbevoie / La Défense » → on ne garde que le dernier segment.
  const z = (zone.includes(' / ') ? zone.split(' / ').pop() : zone).trim();
  const arrondissement = z.match(/^Paris (\d+(?:er|e))\b/);
  if (arrondissement) return `dans le ${arrondissement[1]}`;
  // Garde-fou pour de futures communes du 92 (Le Plessis-Robinson, Les Lilas…).
  if (z.startsWith('Le ')) return `au ${z.slice(3)}`;
  if (z.startsWith('Les ')) return `aux ${z.slice(4)}`;
  return `à ${z}`;
};

// CTA contextuel — piloté par `ctaType` du frontmatter. Le champ est optionnel
// au schéma : une page qui ne le porte pas retombe sur le texte générique.
// Le bouton (« Demander un devis » → /contact) est identique dans les 3 cas.
const ctaPlace = placePhrase(d.zone);
const ctaCopy = {
  corporate: {
    heading: `Un événement d'entreprise ${ctaPlace} ?`,
    lede: 'Cocktail, gala, dîner de direction. Devis personnalisé sous 48 heures.',
  },
  private: {
    heading: `Un dîner privé ${ctaPlace} ?`,
    lede: 'Chef à domicile, célébration, réception. Devis personnalisé sous 48 heures.',
  },
}[d.ctaType] ?? {
  heading: 'Parlons de votre projet',
  lede: 'Un devis personnalisé sous 48 heures.',
};
---

<Layout title={d.title} description={d.description}>
  <!-- Schema.org injecté -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.noctaparis.fr/"},
      {"@type": "ListItem", "position": 2, "name": "Traiteur", "item": "https://www.noctaparis.fr/traiteur"},
      {"@type": "ListItem", "position": 3, "name": d.title, "item": pageUrl}
    ]
  })} />

  <Header light />

  <article class="geo-article">
    <header class="geo-header">
      <p class="geo-eyebrow">Zone desservie · {d.zone}</p>
      <h1 class="geo-title">{displayH1}</h1>
      {d.readingTime && <p class="geo-reading">{d.readingTime} de lecture</p>}
    </header>

    <div class="geo-content">
      <Content />
    </div>

    <!-- Bloc preuve — sobre, réservé à la page Courbevoie/La Défense (slug).
         Éléments réels (repris de la homepage) ; les clients ne sont PAS
         présentés comme situés à La Défense. -->
    {entrySlug === 'traiteur-courbevoie-la-defense' && (
      <section class="geo-proof" aria-label="Ce qui nous rend crédibles">
        <ul class="geo-proof-stats">
          <li><span class="geo-proof-key">50+</span> événements réalisés</li>
          <li>
            <a href="https://g.page/r/CQOWoTg-G7diEBE/review" target="_blank" rel="noopener noreferrer">
              <span class="geo-proof-key">5/5</span> sur Google
            </a>
          </li>
          <li>Équipe formée en cuisine étoilée</li>
        </ul>

        <div class="geo-proof-clients">
          <p class="geo-proof-eyebrow">Ils nous font confiance</p>
          <p class="geo-proof-names">Boucheron · Colombus Consulting · Jus Mundi · The Galion Project · Biologique Recherche · AA Conseil</p>
        </div>

        <blockquote class="geo-proof-quote">
          <p>« L'apéritif, le dîner, le service étaient non seulement parfaits mais aussi très professionnels tout en étant chaleureux. »</p>
          <cite>Valérie Ader — Colombus Consulting</cite>
        </blockquote>
      </section>
    )}

    <!-- FAQ visible — DOIT correspondre mot pour mot au schema FAQPage émis
         plus haut (règle Google : le contenu balisé doit être visible). -->
    {d.faq?.length > 0 && (
      <section class="geo-faq">
        <h2>Questions fréquentes</h2>
        <dl>
          {d.faq.map((item) => (
            <div class="geo-faq-item">
              <dt>{item.question}</dt>
              <dd>{item.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- Autres zones d'intervention — liste propre à chaque page (table
         d'adjacence explicite dans le frontmatter), pour mailler le silo sans
         dupliquer le même bloc de liens sur les 30 pages. -->
    {neighbours.length > 0 && (
      <section class="related-geo">
        <h2>Nos autres zones d'intervention</h2>
        <div class="related-grid">
          {neighbours.map((z) => (
            <a href={`/traiteur/${slugOf(z)}`} class="related-card">
              <span class="related-label">{z.data.zone || 'Île-de-France'}</span>
              <span class="related-title">{z.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CTA réassurance / conversion — titre et accroche pilotés par `ctaType`
         (voir ctaCopy plus haut), bouton identique dans tous les cas. -->
    <section class="geo-cta">
      <h2>{ctaCopy.heading}</h2>
      <p>{ctaCopy.lede}</p>
      <a href="/contact" class="geo-cta-btn">Demander un devis</a>
    </section>

    <!-- Maillage interne : 3 pages prestations -->
    <section class="geo-related">
      <h2>Nos prestations sur {d.zone}</h2>
      <ul>
        <li><a href="/prestations/private">NOCTA Private — dîners privés à domicile</a></li>
        <li><a href="/prestations/corporate">NOCTA Corporate — cocktails, galas, plateaux-repas</a></li>
        <li><a href="/prestations/signature">NOCTA Signature — expériences immersives</a></li>
      </ul>
    </section>
  </article>

  <Footer />
</Layout>

<style>
  .geo-article {
    max-width: 760px;
    margin: 0 auto;
    padding: 5rem 1.5rem 4rem;
    color: var(--color-nocta-text);
  }
  .geo-header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding-bottom: 2rem;
  }
  .geo-eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-nocta-muted);
    margin-bottom: 0.75rem;
  }
  .geo-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    margin: 0 0 0.75rem;
    color: var(--color-nocta-ink);
  }
  .geo-reading {
    font-size: 0.9rem;
    color: var(--color-nocta-grey);
  }
  .geo-content :global(h2) {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.65rem;
    margin: 2.5rem 0 1rem;
    color: var(--color-nocta-ink);
  }
  .geo-content :global(p) {
    font-size: 1.05rem;
    line-height: 1.75;
    margin: 0 0 1.1rem;
  }
  .geo-content :global(a) {
    color: var(--color-nocta-ink);
    border-bottom: 1px solid rgba(0, 0, 0, 0.25);
    text-decoration: none;
  }
  .geo-content :global(a):hover {
    border-bottom-color: var(--color-nocta-ink);
  }

  /* FAQ visible — sobre, aligné sur la typo éditoriale cream */
  .geo-faq {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
  .geo-faq > h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.8rem;
    font-weight: 400;
    margin: 0 0 1.5rem;
    color: var(--color-nocta-ink);
  }
  .geo-faq-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .geo-faq-item:last-child {
    border-bottom: none;
  }
  .geo-faq dt {
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--color-nocta-ink);
    margin-bottom: 0.5rem;
  }
  .geo-faq dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-nocta-text);
  }

  /* Bloc preuve — sobre, sur cream, aligné sur la charte éditoriale GEO */
  .geo-proof {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
  .geo-proof-stats {
    list-style: none;
    padding: 0;
    margin: 0 0 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
  }
  .geo-proof-stats li {
    font-size: 0.95rem;
    color: var(--color-nocta-text);
  }
  .geo-proof-stats a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
    transition: border-color 0.2s ease;
  }
  .geo-proof-stats a:hover {
    border-bottom-color: var(--color-nocta-ink);
  }
  .geo-proof-key {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 1.35rem;
    color: var(--color-nocta-ink);
    margin-right: 0.15rem;
  }
  .geo-proof-eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-nocta-muted);
    margin: 0 0 0.5rem;
  }
  .geo-proof-names {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-nocta-text);
    margin: 0 0 2.25rem;
  }
  .geo-proof-quote {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 2px solid rgba(0, 0, 0, 0.15);
  }
  .geo-proof-quote p {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-nocta-ink);
    margin: 0 0 0.75rem;
  }
  .geo-proof-quote cite {
    font-style: normal;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-nocta-muted);
  }

  /* CTA inliné — pattern aligné avec journal/[slug].astro */
  .geo-cta {
    margin-top: 4rem;
    padding: 4rem 2rem;
    background: var(--color-nocta-black);
    color: #EEEBE3;
    text-align: center;
  }
  .geo-cta h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0 0 0.75rem;
    color: #EEEBE3;
  }
  .geo-cta p {
    font-size: 0.95rem;
    margin: 0 0 2rem;
    opacity: 0.7;
  }
  .geo-cta-btn {
    display: inline-block;
    background: #EEEBE3;
    color: var(--color-nocta-black);
    padding: 0.85rem 2rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    transition: background 0.3s ease;
  }
  .geo-cta-btn:hover {
    background: #ffffff;
  }

  .geo-related {
    margin-top: 4rem;
    padding: 2rem;
    background: #EEEBE3;
    border-radius: 4px;
  }
  .geo-related h2 {
    margin: 0 0 1rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.5rem;
  }
  .geo-related ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .geo-related li {
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .geo-related li:last-child {
    border-bottom: none;
  }

  /* Maillage interne : autres zones desservies */
  .related-geo {
